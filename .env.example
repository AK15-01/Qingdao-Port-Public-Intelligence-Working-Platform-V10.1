# Optional DeepSeek assistance. Leave blank to keep all AI features disabled.
# Copy this file to .env on your own computer, then fill the key locally.
PUBLIC_DEMO_MODE=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_AGENT_MODEL=deepseek-v4-pro
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
